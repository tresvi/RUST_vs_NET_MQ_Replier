{
  "Mq": {
    "Channel": "CHANNEL1",
    "ManagerName": "MQGD",
    "ServerIp": "192.168.0.31",
    "ServerPort": 1414,
    "User": null,
    "Password": null,
    "InputQueue": "BNA.TU5.PEDIDO",
    "ReplyQueue": "BNA.TU5.RESPUESTA",
    "GetWaitIntervalMs": 5000
  },
  "Test": {
    "MessageCount": 1000,
    "WarmupCount": 10,
    "ReplyTimeoutMs": 5000,
    "Concurrency": 32,

    // Texto de cada pedido. Si queda en null o vacío, se genera uno distinto por mensaje (secuencia, hilo y timestamp), útil para verificar que el echo es correcto.
    "Message": null,
    // CCSID con el que se codifica el texto y se marca el MQMD. 1208 = UTF-8, 819 = ISO-8859-1, 1252 = Windows-1252, 37/500/1047 = EBCDIC.
    "CharacterSet": 1208,
    // Formato del MQMD (hasta 8 caracteres). "MQSTR" = cadena; vacío = MQFMT_NONE.
    "Format": "MQSTR"
  }
}
